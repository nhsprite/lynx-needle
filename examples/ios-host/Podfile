platform :ios, '12.0'
source 'https://cdn.cocoapods.org/'

target 'NeedleHost' do
  # Lynx runtime (its podspec already pulls PrimJS quickjs + napi subspecs)
  # + the weak Node-API bridge.
  pod 'Lynx', '3.9.0'
  pod 'LynxWeakNodeAPI', :subspecs => ['core', 'primjs_bridge']

  # The needle addon + addon loader module (this repo's iOS SDK).
  pod 'needle', :path => '../../ios'
end

# Work around duplicate Node-API headers in the published pods: PrimJS's napi
# sources in subdirectories quote-include "js_native_api.h" /
# "js_native_api_types.h", and Xcode's all-target header map resolves those
# names to the LynxWeakNodeAPI copies (which declare different macros), causing
# redefinition / unknown-NAPI_EXTERN errors. For quoted includes clang checks
# the including file's own directory first, so dropping tiny forwarding headers
# into each subdirectory pins resolution to PrimJS's own headers.
post_install do |installer|
  napi_dir = File.join(installer.sandbox.root.to_s, 'PrimJS', 'src', 'napi')
  forward = %w[js_native_api.h js_native_api_types.h napi.h]
  %w[quickjs env common jsc].each do |sub|
    dir = File.join(napi_dir, sub)
    next unless Dir.exist?(dir)
    forward.each do |header|
      next unless File.exist?(File.join(napi_dir, header))
      File.write(File.join(dir, header),
                 "// Forwarder generated by the Podfile post_install hook; see Podfile.\n" \
                 "#include \"../#{header}\"\n")
    end
  end
end
