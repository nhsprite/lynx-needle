{
  "name": "lynx-needle-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/lynx-needle"
  ],
  "scripts": {
    "build": "npm --workspace lynx-needle run build",
    "codegen": "npm --workspace lynx-needle run codegen",
    "fetch-engine": "npm --workspace lynx-needle run fetch-engine",
    "deps:android": "npm --workspace lynx-needle run deps:android",
    "build:android": "npm --workspace lynx-needle run build:android",
    "build:ios": "npm --workspace lynx-needle run build:ios",
    "build:macos": "npm --workspace lynx-needle run build:macos",
    "package:darwin": "npm --workspace lynx-needle run package:darwin",
    "pack:needle": "npm --workspace lynx-needle pack --dry-run --json --silent"
  }
}
